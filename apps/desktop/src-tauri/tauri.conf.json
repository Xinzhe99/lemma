{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lemma",
  "version": "6.9.0",
  "identifier": "com.lemma.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lemma — 科研写作工作站",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "© 2026 Lemma",
    "shortDescription": "AI-native scholarly writing workstation",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE2RkQ4MzMyQzI1MDRCQjAKUldTd1MxRENNb1A5Rm9rTEFrblRQNVpFbFBnMXpGZHArMWNLUnhTTlJuZWJkZDBRR3puaFlQV2MK",
      "endpoints": [
        "https://github.com/Xinzhe99/lemma/releases/latest/download/latest.json"
      ]
    }
  }
}
